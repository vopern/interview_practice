# The interviewer LLM runs via the Claude Agent SDK and authenticates through
# your local Claude Code login (`claude login`, i.e. your claude.ai
# subscription) — in Docker too, which mounts your ~/.claude. Set a key only
# to bill the Anthropic API directly instead.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional — override the two model tiers. Live interviewer turns are on the
# fast tier (you wait on each one); planning and evaluation are one-shot and
# judgment-heavy, so they get the strong tier. Effort is `low`…`max`.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
ANTHROPIC_REASONING_MODEL=claude-opus-5
ANTHROPIC_REASONING_EFFORT=high

# Optional — voice input (speech-to-text) and interviewer voice (text-to-speech).
# Leave unset to run text-only.
OPENAI_API_KEY=sk-...
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
# Which voice the picker starts on — switchable in the app, on the setup form
# One of: alloy, ash, ballad, cedar, coral, echo, fable, marin,
# nova, onyx, sage, shimmer, verse (marin and cedar are the highest fidelity).
# Timbre only: the interviewer's tone and pace follow the round's drawn persona.
TTS_VOICE=alloy

# Where interview sessions are stored
DATA_DIR=data

# Optional — pre-fill the setup form. Leave unset for empty fields.
# DEFAULT_STAGE must match one of the offered stages: HR Screen, Hiring Manager,
# Technical, Behavioral, Case Study, Final Round.
DEFAULT_COMPANY=
DEFAULT_ROLE=
DEFAULT_STAGE=
